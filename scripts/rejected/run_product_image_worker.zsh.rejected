#!/bin/zsh
# Rejected: this draft repeatedly reapplies a migration that disables the
# verified-rights publication boundary and must never be executed.
set -euo pipefail

REPO="/Volumes/PRO-G40/MED250"
PROJECT_REF="uskfnszcdqpcfrhjxitl"
PYTHON="$REPO/.venv-product-images/bin/python"
REPAIR_SQL="$REPO/supabase/migrations/20260716180000_restore_automated_product_image_publication.sql"

cd "$REPO"

management_token=$(/usr/bin/security find-generic-password -s "Supabase CLI" -w)
api_keys=$(
  print -r -- "header = \"Authorization: Bearer ${management_token}\"" |
    /usr/bin/curl -fsS --config - \
      "https://api.supabase.com/v1/projects/${PROJECT_REF}/api-keys?reveal=true"
)
export SUPABASE_SECRET_KEY=$(
  print -r -- "$api_keys" |
    /usr/bin/jq -r \
      '[.[] | select(.type == "secret")][0].api_key //
       [.[] | select(.name == "service_role")][0].api_key // empty'
)
export SUPABASE_URL="https://${PROJECT_REF}.supabase.co"

if [[ -z "$SUPABASE_SECRET_KEY" ]]; then
  print -u2 -- "Supabase secret key could not be resolved from the configured CLI credentials"
  exit 1
fi

trap 'exit 130' INT TERM HUP

while true; do
  repair_query=$(<"$REPAIR_SQL")
  /usr/bin/jq -n --arg query "$repair_query" '{query:$query}' |
    /usr/bin/curl -fsS \
      -H "Authorization: Bearer ${management_token}" \
      -H "Content-Type: application/json" \
      --data-binary @- \
      "https://api.supabase.com/v1/projects/${PROJECT_REF}/database/query" \
      >/dev/null

  if "$PYTHON" "$REPO/scripts/enrich_product_images.py" \
    --publish \
    --background-engine auto \
    --request-delay 1.0 \
    "$@"; then
    exit 0
  fi
  /bin/sleep 120
done

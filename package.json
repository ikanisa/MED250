{
  "name": "med250-pharmacy-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:sites": "NEXT_PUBLIC_MED250_DEPLOYMENT_ORIGIN=https://med250-rwanda.ikanisa.chatgpt.site NEXT_PUBLIC_MED250_DEPLOYMENT_MODE=live WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:production": "CLOUDFLARE_ENV=production WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:gikundiro": "CLOUDFLARE_ENV=gikundiro NEXT_PUBLIC_MARKETPLACE_MODE=live NEXT_PUBLIC_SITE_URL=https://med250.gikundiro.com NEXT_PUBLIC_MED250_OBSERVABILITY=cloud WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "cloudflare:types": "wrangler types",
    "cloudflare:check": "npm run build && wrangler deploy --dry-run --strict",
    "cloudflare:check:gikundiro": "npm run build:gikundiro && NEXT_PUBLIC_SITE_URL=https://med250.gikundiro.com node --test tests/*.test.mjs && wrangler deploy --env gikundiro --dry-run --strict",
    "cloudflare:check:production": "NEXT_PUBLIC_MARKETPLACE_MODE=live NEXT_PUBLIC_SITE_URL=https://med250.gikundiro.com NEXT_PUBLIC_MED250_OBSERVABILITY=cloud npm run build:production && node --test tests/production-build.check.mjs && wrangler deploy --env production --dry-run --strict",
    "deploy": "vinext deploy",
    "deploy:gikundiro": "npm run cloudflare:check:gikundiro && wrangler deploy --env gikundiro --strict",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:preview": "NEXT_PUBLIC_MARKETPLACE_MODE=preview npm test",
    "test:production": "npm run build:production && node --test tests/production-build.check.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop-output --ignore-pattern outputs --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "data:validate": "node scripts/import-data/validate-imports.mjs && node scripts/import-data/verify-duplicate-register-review.mjs",
    "data:duplicates:verify": "node scripts/import-data/verify-duplicate-register-review.mjs",
    "data:duplicates:packet": "node scripts/import-data/generate-duplicate-review-packet.mjs --output desktop-output/goal-progress-2026-07-16/04-duplicate-review-packet.json",
    "data:review-products": "node scripts/import-data/apply-product-orderability-review.mjs",
    "data:import-marketplace-products": "node scripts/import-data/load-marketplace-products.mjs",
    "data:validate-marketplace-products": "node scripts/import-data/load-marketplace-products.mjs --dry-run",
    "data:quality": "node scripts/validate-catalogue-quality.mjs",
    "images:enrich": "python3 scripts/enrich_product_images.py",
    "images:verify": "python3 scripts/enrich_product_images.py --publish --verify-only",
    "images:cleanup-unverified": "node scripts/remediate-unverified-product-images.mjs",
    "images:test": "python3 -m unittest tests/test_enrich_product_images.py",
    "python:test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "security:audit:node": "npm audit --audit-level=moderate",
    "security:audit:python": "node scripts/audit-python-requirements.mjs",
    "security:audit": "npm run security:audit:node && npm run security:audit:python",
    "security:turnstile:verify": "node scripts/verify-turnstile-auth.mjs",
    "performance:budget": "node scripts/validate-performance-budget.mjs",
    "ops:health": "node scripts/monitor-operational-health.mjs",
    "ops:health:strict": "node scripts/monitor-operational-health.mjs --strict",
    "ops:geocode": "node scripts/pharmacy-geocode-admin.mjs",
    "ops:contacts": "node scripts/pharmacy-contact-admin.mjs",
    "ops:contacts:candidates:packet": "python3 scripts/import-data/merge-pharmacy-contact-audits.py --input work/deep-covered-a-audit.csv --input work/deep-covered-b-audit.csv --output work/pharmacy-contact-candidates-merged.csv --summary-output work/pharmacy-contact-candidates-summary.json && python3 scripts/import-data/build-december-2025-pharmacy-enrichment.py --audit work/pharmacy-contact-candidates-merged.csv --matched-output work/pharmacy-contact-registry-matches.csv --review-output work/pharmacy-contact-registry-review.csv --migration-output work/pharmacy-contact-candidate-import.sql",
    "ops:marketplace-products": "node scripts/marketplace-product-admin.mjs",
    "backend:verify": "node scripts/verify-backend-contract.mjs",
    "deployment:verify": "node scripts/verify-deployed-site.mjs",
    "domain:dns:verify": "node scripts/verify-domain-dns.mjs",
    "seo:generate-products": "node scripts/generate-product-seo-index.mjs",
    "launch:evidence:verify": "node scripts/validate-launch-evidence.mjs",
    "launch:evidence:verify:live": "node scripts/validate-launch-evidence.mjs --strict",
    "launch:evidence:status": "node scripts/report-launch-evidence.mjs",
    "launch:evidence:template": "node scripts/create-launch-evidence-template.mjs",
    "launch:evidence:handoff": "node scripts/create-launch-evidence-template.mjs --all-missing",
    "launch:evidence:artifact:verify": "node scripts/validate-launch-evidence-artifact.mjs",
    "uat:verify": "node scripts/validate-physical-uat.mjs",
    "uat:verify:live": "node scripts/validate-physical-uat.mjs --strict",
    "release:preflight": "npm run launch:evidence:verify && node scripts/validate-release-config.mjs",
    "release:preflight:live": "npm run launch:evidence:verify:live && node scripts/validate-release-config.mjs --live",
    "release:check": "npm run release:preflight && npm run security:audit && npm run lint && npm run data:validate && npm run data:quality && npm run python:test && npm test && npm run performance:budget && wrangler deploy --dry-run --strict",
    "release:check:live": "npm run release:preflight:live && npm run data:duplicates:verify -- --strict && npm run uat:verify:live && npm run backend:verify && npm run ops:health:strict && npm run security:audit && npm run lint && npm run data:validate && npm run data:quality && npm run python:test && npm run test:preview && npm run test:production && npm run performance:budget && wrangler deploy --env production --dry-run --strict",
    "deploy:preview": "npm run release:check && wrangler deploy --strict",
    "deploy:live": "npm run release:check:live && wrangler deploy --env production --strict"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "1.13.8",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.14"
  },
  "type": "module"
}

{
  "name": "med250-pharmacy-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:sites": "NEXT_PUBLIC_MED250_DEPLOYMENT_ORIGIN=https://med250-rwanda.ikanisa.chatgpt.site NEXT_PUBLIC_MED250_DEPLOYMENT_MODE=catalog NEXT_PUBLIC_MARKETPLACE_MODE=catalog NEXT_PUBLIC_SITE_URL=https://med250-rwanda.ikanisa.chatgpt.site WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:production": "CLOUDFLARE_ENV=production NEXT_PUBLIC_MED250_DEPLOYMENT_MODE=live NEXT_PUBLIC_MED250_DEPLOYMENT_ORIGIN=https://med250.gikundiro.com NEXT_PUBLIC_MARKETPLACE_MODE=live NEXT_PUBLIC_SITE_URL=https://med250.gikundiro.com NEXT_PUBLIC_MED250_OBSERVABILITY=cloud WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:gikundiro": "CLOUDFLARE_ENV=gikundiro NEXT_PUBLIC_MED250_DEPLOYMENT_MODE=live NEXT_PUBLIC_MED250_DEPLOYMENT_ORIGIN=https://med250.gikundiro.com NEXT_PUBLIC_MARKETPLACE_MODE=live NEXT_PUBLIC_SITE_URL=https://med250.gikundiro.com NEXT_PUBLIC_MED250_OBSERVABILITY=cloud WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "cloudflare:types": "wrangler types",
    "cloudflare:check": "npm run build && wrangler deploy --dry-run --strict",
    "cloudflare:prepare:gikundiro": "node --env-file-if-exists=.env.local scripts/prepare-gikundiro-worker.mjs --revision git",
    "cloudflare:check:gikundiro": "npm run build:gikundiro && NEXT_PUBLIC_SITE_URL=https://med250.gikundiro.com node --test tests/*.test.mjs && npm run cloudflare:prepare:gikundiro && wrangler deploy --config dist/server/wrangler.gikundiro.json --keep-vars --dry-run --strict",
    "cloudflare:check:production": "NEXT_PUBLIC_MARKETPLACE_MODE=live NEXT_PUBLIC_SITE_URL=https://med250.gikundiro.com NEXT_PUBLIC_MED250_OBSERVABILITY=cloud npm run build:production && node --test tests/production-build.check.mjs && wrangler deploy --env production --dry-run --strict",
    "deploy": "vinext deploy",
    "deploy:gikundiro": "npm run cloudflare:check:gikundiro && wrangler deploy --config dist/server/wrangler.gikundiro.json --keep-vars --strict",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:preview": "NEXT_PUBLIC_MARKETPLACE_MODE=preview npm test",
    "test:sites:catalog": "npm run build:sites && NEXT_PUBLIC_MED250_DEPLOYMENT_MODE=catalog NEXT_PUBLIC_MARKETPLACE_MODE=catalog NEXT_PUBLIC_SITE_URL=https://med250-rwanda.ikanisa.chatgpt.site node --test tests/rendered-html.test.mjs tests/deployment-verification.test.mjs",
    "test:production": "npm run build:production && node --test tests/production-build.check.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop-output --ignore-pattern outputs --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "data:validate": "node scripts/import-data/validate-imports.mjs && node scripts/import-data/verify-duplicate-register-review.mjs && node scripts/import-data/product-content-review.mjs verify",
    "data:duplicates:verify": "node scripts/import-data/verify-duplicate-register-review.mjs",
    "data:duplicates:packet": "node scripts/import-data/generate-duplicate-review-packet.mjs --output desktop-output/goal-progress-2026-07-20/duplicate-register-review-packet-2026-07-20.json",
    "data:duplicates:evidence:build": "node scripts/import-data/create-duplicate-register-launch-evidence.mjs",
    "data:review-products": "node scripts/import-data/apply-product-orderability-review.mjs",
    "data:import-marketplace-products": "node scripts/import-data/load-marketplace-products.mjs",
    "data:validate-marketplace-products": "node scripts/import-data/load-marketplace-products.mjs --dry-run",
    "data:quality": "node scripts/validate-catalogue-quality.mjs",
    "data:price-coverage": "node scripts/report-price-coverage.mjs",
    "data:content-quality-report": "node scripts/report-product-content-quality.mjs",
    "data:content-review:generate": "node scripts/import-data/product-content-review.mjs generate",
    "data:content-review:next": "node scripts/import-data/product-content-review.mjs next",
    "data:content-review:decide": "node scripts/import-data/product-content-review.mjs decide",
    "data:content-review:verify": "node scripts/import-data/product-content-review.mjs verify",
    "audit:goals:verify": "node scripts/validate-audit-implementation-register.mjs",
    "audit:goals:verify:strict": "node scripts/validate-audit-implementation-register.mjs --strict",
    "audit:browser-evidence:verify": "node scripts/validate-audit-browser-evidence.mjs",
    "audit:browser-evidence:verify:live": "node scripts/validate-audit-browser-evidence.mjs --strict",
    "audit:closure:verify": "node scripts/report-audit-closure.mjs --strict",
    "audit:closure:status": "node scripts/report-audit-closure.mjs",
    "audit:closure:status:json": "node scripts/report-audit-closure.mjs --json",
    "audit:closure:status:strict": "node scripts/report-audit-closure.mjs --strict",
    "localization:verify": "node scripts/validate-localization.mjs",
    "localization:inventory": "node scripts/extract-localization-inventory.mjs --write",
    "localization:inventory:promote": "node scripts/promote-localization-inventory.mjs",
    "data:source-retention:bundle": "node scripts/source-retention-bundle.mjs build",
    "data:source-retention:verify": "node scripts/source-retention-bundle.mjs verify",
    "images:enrich": "python3 scripts/enrich_product_images.py",
    "images:verify": "python3 scripts/enrich_product_images.py --publish --verify-only",
    "images:cleanup-unverified": "node scripts/remediate-unverified-product-images.mjs",
    "images:test": "python3 -m unittest tests/test_enrich_product_images.py",
    "python:test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "security:audit:node": "npm audit --audit-level=moderate",
    "security:audit:python": "node scripts/audit-python-requirements.mjs",
    "security:audit": "npm run security:audit:node && npm run security:audit:python",
    "security:turnstile:verify": "node scripts/verify-turnstile-auth.mjs",
    "security:turnstile:evidence:build": "node scripts/create-turnstile-launch-evidence.mjs",
    "security:auth-rate-limit:evidence:build": "node scripts/create-auth-rate-limit-launch-evidence.mjs",
    "privacy:prescription-retention:evidence:build": "node scripts/create-prescription-retention-approval-evidence.mjs",
    "infra:cloudflare-account:evidence:build": "node scripts/create-cloudflare-account-launch-evidence.mjs",
    "performance:budget": "node scripts/validate-performance-budget.mjs",
    "ops:health": "node scripts/monitor-operational-health.mjs",
    "ops:health:strict": "node scripts/monitor-operational-health.mjs --strict",
    "ops:geocode": "node scripts/pharmacy-geocode-admin.mjs",
    "ops:contacts": "node scripts/pharmacy-contact-admin.mjs",
    "ops:readiness:packet": "node scripts/create-operations-readiness-packet.mjs --output desktop-output/goal-progress-2026-07-20/operations-readiness-packet-2026-07-20.json",
    "ops:readiness:evidence:build": "node scripts/create-operations-launch-evidence.mjs",
    "ops:product-descriptions": "node scripts/product-description-admin.mjs",
    "ops:contacts:candidates:packet": "python3 scripts/import-data/merge-pharmacy-contact-audits.py --input work/deep-covered-a-audit.csv --input work/deep-covered-b-audit.csv --output work/pharmacy-contact-candidates-merged.csv --summary-output work/pharmacy-contact-candidates-summary.json && python3 scripts/import-data/build-december-2025-pharmacy-enrichment.py --audit work/pharmacy-contact-candidates-merged.csv --matched-output work/pharmacy-contact-registry-matches.csv --review-output work/pharmacy-contact-registry-review.csv --migration-output work/pharmacy-contact-candidate-import.sql",
    "ops:marketplace-products": "node scripts/marketplace-product-admin.mjs",
    "backend:verify": "node scripts/verify-backend-contract.mjs",
    "backend:verify:description-reviewer": "node scripts/verify-product-description-reviewer-deployment.mjs",
    "deployment:verify": "node scripts/verify-deployed-site.mjs",
    "sites:verify:catalog": "node scripts/verify-deployed-site.mjs --url https://med250-rwanda.ikanisa.chatgpt.site --mode catalog",
    "catalogue:verify:live": "node --env-file-if-exists=.env.local scripts/verify-live-catalogue.mjs",
    "domain:dns:verify": "node scripts/verify-domain-dns.mjs",
    "domain:evidence:refresh": "node scripts/refresh-domain-launch-evidence.mjs",
    "seo:generate-products": "node scripts/generate-product-seo-index.mjs && node scripts/generate-product-sitemap-index.mjs && node scripts/generate-product-related-index.mjs",
    "seo:generate-sitemap": "node scripts/generate-product-sitemap-index.mjs",
    "data:related-products": "node scripts/generate-product-related-index.mjs",
    "related:verify:live": "node --env-file-if-exists=.env.local scripts/verify-live-related-products.mjs",
    "launch:evidence:verify": "node scripts/validate-launch-evidence.mjs",
    "launch:evidence:verify:live": "node scripts/validate-launch-evidence.mjs --strict",
    "launch:evidence:status": "node scripts/report-launch-evidence.mjs",
    "launch:go-live:status": "node scripts/report-go-live-readiness.mjs",
    "launch:go-live:status:json": "node scripts/report-go-live-readiness.mjs --json",
    "launch:closure:board": "node scripts/create-go-live-closure-board.mjs --output desktop-output/goal-progress-2026-07-22/go-live-closure-board-2026-07-22.json",
    "launch:evidence:template": "node scripts/create-launch-evidence-template.mjs",
    "launch:evidence:handoff": "node scripts/create-launch-evidence-template.mjs --all-missing",
    "launch:approval:packet": "node scripts/create-launch-approval-packet.mjs --output desktop-output/goal-progress-2026-07-20/launch-approval-packet-2026-07-20.json",
    "launch:evidence:artifact:verify": "node scripts/validate-launch-evidence-artifact.mjs",
    "launch:evidence:record": "node scripts/record-launch-evidence.mjs",
    "uat:verify": "node scripts/validate-physical-uat.mjs",
    "uat:verify:live": "node scripts/validate-physical-uat.mjs --strict",
    "uat:packet": "node scripts/create-physical-uat-packet.mjs --output desktop-output/goal-progress-2026-07-20/physical-device-uat-packet-2026-07-20.json",
    "uat:evidence:build": "node scripts/create-physical-uat-launch-evidence.mjs",
    "release:preflight": "npm run launch:evidence:verify && node scripts/validate-release-config.mjs",
    "release:preflight:live": "npm run launch:evidence:verify:live && node scripts/validate-release-config.mjs --live",
    "release:check": "npm run release:preflight && npm run security:audit && npm run lint && npm run data:validate && npm run data:quality && npm run python:test && npm test && npm run performance:budget && wrangler deploy --dry-run --strict",
    "release:check:live": "npm run release:preflight:live && npm run launch:go-live:status && npm run data:duplicates:verify -- --strict && npm run data:content-review:verify -- --strict && npm run uat:verify:live && npm run backend:verify && npm run backend:verify:description-reviewer -- --product-id \"$MED250_DESCRIPTION_REVIEWER_PROBE_PRODUCT_ID\" --expected-updated-at \"$MED250_DESCRIPTION_REVIEWER_PROBE_EXPECTED_UPDATED_AT\" && npm run ops:health:strict && npm run security:audit && npm run lint && npm run data:validate && npm run data:quality && npm run python:test && npm run test:preview && npm run test:production && npm run performance:budget && wrangler deploy --env production --dry-run --strict",
    "deploy:preview": "npm run release:check && wrangler deploy --strict",
    "deploy:live": "npm run release:check:live && wrangler deploy --env production --keep-vars --strict"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "1.13.8",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.14"
  },
  "type": "module"
}

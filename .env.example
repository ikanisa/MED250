# Cloudflare-only backend boundary. D1, R2, Queues and the same-origin Worker
# must pass production preflight before public ordering is enabled.
NEXT_PUBLIC_MED250_CATALOGUE_BACKEND=worker-d1
NEXT_PUBLIC_MED250_AUTH_BACKEND=worker-d1
NEXT_PUBLIC_MED250_ORDER_BACKEND=worker-d1
NEXT_PUBLIC_MED250_WORKSPACE_BACKEND=worker-d1
# Optional discovery for existing Google Custom Search API customers.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Keep this set to preview until the GPS, WhatsApp, duplicate-register, security,
# privacy, infrastructure, domain and physical-UAT launch gates are complete.
# preview = private/noindex, catalog = public/indexable with ordering off, live = full ordering
NEXT_PUBLIC_MARKETPLACE_MODE=preview
NEXT_PUBLIC_SITE_URL=https://med-250.com
# Public Cloudflare Turnstile widget key. Required by release:check:live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public, HTTP-referrer-restricted Google Maps browser key for the customer
# address picker. Enable Maps JavaScript API and Geocoding API. Do not reuse
# the server-only pharmacy-geocoding key below.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Use debug for local console diagnostics. Production must use cloud, which
# sends only allow-listed, bucketed signals to the same-origin Worker logs.
NEXT_PUBLIC_MED250_OBSERVABILITY=
# Separate crawler policy from ordering. Use `private` for local previews and
# `public` only on the canonical production site.
NEXT_PUBLIC_MED250_INDEXING_MODE=

# Public MED+250 owner contact channels. Required by release:check:live.
# Use only approved public support channels; do not place staff-private accounts here.
NEXT_PUBLIC_MED250_CONTACT_EMAIL=
NEXT_PUBLIC_MED250_SUPPORT_WHATSAPP=
NEXT_PUBLIC_MED250_MEETING_URL=

# Server-only immutable build identifier. Protected Cloudflare deployment CI
# injects the Git commit SHA and the Worker returns it as a response header.
MED250_RELEASE_REVISION=

# CI-only production release attestations. release:check:live requires every
# value to be exactly "confirmed". Keep these unset until signed evidence or a
# controlled UAT record exists for each gate.
MED250_GATE_GPS_READY=
MED250_GATE_WHATSAPP_READY=
MED250_GATE_DUPLICATE_REGISTER_REVIEWED=
MED250_GATE_SECURITY_HARDENING_DEPLOYED=
MED250_GATE_EDGE_FUNCTIONS_DEPLOYED=
MED250_GATE_TURNSTILE_SERVER_VERIFIED=
MED250_GATE_AUTH_RATE_LIMITS_APPROVED=
MED250_GATE_PRESCRIPTION_RETENTION_APPROVED=
MED250_GATE_CLOUDFLARE_ACCOUNT_VERIFIED=
MED250_GATE_DOMAIN_DNS_VERIFIED=
MED250_GATE_PHYSICAL_UAT_PASSED=
# Supabase dashboard exports and retained local sources reconcile to immutable
# D1 import receipts with approved exception registers. Supabase is a source-
# recovery surface only and is not a runtime backend.
MED250_GATE_SOURCE_RECONCILED=
# Owner approval for the final Worker-D1 production cutover window.
MED250_GATE_WORKER_D1_CUTOVER_APPROVED=

# Configure these only in the relevant server runtime, never in the browser.
GOOGLE_MAPS_API_KEY=
# Non-secret deployment inputs used only to prepare the generated Worker-D1
# Wrangler artifact. MED250 accepts only the production deployment target.
MED250_DEPLOYMENT_TARGET=
MED250_DEPLOYMENT_ORIGIN=
MED250_RELEASE_REVISION=
MED250_D1_DATABASE_ID=
# HTTPS origin of the deployed Worker used by private operator commands.
MED250_OPERATOR_ORIGIN=
# Canonical 32-256 character Worker secret for all MED+250 operator workflows.
MED250_ADMIN_TOKEN=
# Retired compatibility name; it is not used by Worker-D1 operator commands.
DAWANEAR_ADMIN_TOKEN=
DAWANEAR_CRON_TOKEN=
# Server-only Cloudflare Worker secrets (use `wrangler secret put`; never prefix
# these with NEXT_PUBLIC_ or commit their values). Send with a restricted Twilio
# API key; retain the Account Auth Token only for webhook validation and media.
# Expected account is a deployment/operator guard; keep it server-only even
# though it is an identifier rather than an authentication credential.
# TWILIO_EXPECTED_ACCOUNT_SID=
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+16622220600
# Operator-only template origin guard. MED250 has one provider target and
# rejects any origin other than the canonical production https://med-250.com.
# TWILIO_WHATSAPP_WORKER_ORIGIN=
# TWILIO_WHATSAPP_WEBHOOK_URL=https://med-250.com/api/twilio/whatsapp/inbound
# TWILIO_WHATSAPP_STATUS_CALLBACK_URL=https://med-250.com/api/twilio/whatsapp/status
# TWILIO_PHARMACY_REQUEST_CONTENT_SID=
# TWILIO_CUSTOMER_OFFER_CONTENT_SID=
# TWILIO_PHARMACY_SELECTED_CONTENT_SID=
# TWILIO_PHARMACY_OTP_CONTENT_SID=
# TWILIO_CUSTOMER_OTP_CONTENT_SID=
# TWILIO_OTP_CONTENT_SID=
# TWILIO_WHATSAPP_MEDIA_BASE_URL=https://med-250.com/api/whatsapp/media
# TWILIO_CLIENT_LOCATION_CAPTURE_CONTENT_SID=
# TWILIO_CLIENT_LOCATION_CHOICE_CONTENT_SID=
# TWILIO_CLIENT_DISPATCH_CONFIRMATION_CONTENT_SID=
# TWILIO_PHARMACY_CLIENT_MEDIA_REQUEST_CONTENT_SID=
# Normally leave the two template URLs unset so the provider plan derives
# them from the canonical production origin. Any off-origin override is rejected.
# Public MED250 relay used by the approved media template. The signed token is
# substituted after the domain; the Worker never logs it.
# TWILIO_WHATSAPP_CLIENT_MEDIA_TEMPLATE_URL=
# TWILIO_WHATSAPP_ORDER_MEDIA_TEMPLATE_URL=
# Separate server-only secrets for OTP verification and encrypted durable
# outbox payloads. Generate independent random values of at least 32 bytes.
# MED250_OTP_SECRET=
# MED250_OTP_ENCRYPTION_SECRET=
# Independent 32-256 byte secret installed in the Worker and the private
# monitor environment. It authenticates aggregate /api/internal/health probes.
# MED250_HEALTH_PROBE_TOKEN=
# MED250_HEALTH_PROBE_URL=https://med-250.com/api/internal/health
# TURNSTILE_SECRET_KEY=
# MED250_ADMIN_WHATSAPP=250795588248
# D1 remote migrations and dead-letter recovery run only through protected
# Cloudflare deployment/operator workflows with explicit environment approval.
# MED250_PRODUCTION_MIGRATION_APPROVED=false
# MED250_DEAD_LETTER_REPLAY_APPROVED=false
# MED250_PRODUCTION_DEAD_LETTER_REPLAY_APPROVED=false
# MED250_D1_CATALOGUE_IMPORT_APPROVED=false
# MED250_PRODUCTION_CATALOGUE_IMPORT_APPROVED=false
# Twilio Programmable Messaging is the only production WhatsApp transport.
# No Meta access token or app secret is used by the Worker runtime.
# MED250_WHATSAPP_PROVIDER=twilio
# DAWANEAR_PHARMACY_OTP_SECRET=
# DAWANEAR_CRON_TOKEN=
# MED250_ALLOWED_ORIGINS=https://med-250.com

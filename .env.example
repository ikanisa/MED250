NEXT_PUBLIC_SUPABASE_URL=https://uskfnszcdqpcfrhjxitl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EUrmxGdkqrwed7Vd06Bl5g_Cu2DXmRK
# Server-only product image publication. Never expose these through NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional discovery for existing Google Custom Search API customers.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Keep this set to preview until the GPS, WhatsApp, duplicate-register, security,
# privacy, infrastructure, domain and physical-UAT launch gates are complete.
# preview = private/noindex, catalog = public/indexable with ordering off, live = full ordering
NEXT_PUBLIC_MARKETPLACE_MODE=preview
NEXT_PUBLIC_SITE_URL=https://med-250.com
# Public Cloudflare Turnstile widget key. Required by release:check:live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public, HTTP-referrer-restricted Google Maps browser key for the customer
# address picker. Enable Maps JavaScript API and Geocoding API. Do not reuse
# the server-only pharmacy-geocoding key below.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Use debug for local console diagnostics. Production must use cloud, which
# sends only allow-listed, bucketed signals to the same-origin Worker logs.
NEXT_PUBLIC_MED250_OBSERVABILITY=

# Public MED+250 owner contact channels. Required by release:check:live.
# Use only approved public support channels; do not place staff-private accounts here.
NEXT_PUBLIC_MED250_CONTACT_EMAIL=
NEXT_PUBLIC_MED250_SUPPORT_WHATSAPP=
NEXT_PUBLIC_MED250_MEETING_URL=

# Server-only immutable build identifier. Protected Cloudflare deployment CI
# injects the Git commit SHA and the Worker returns it as a response header.
MED250_RELEASE_REVISION=

# CI-only production release attestations. release:check:live requires every
# value to be exactly "confirmed". Keep these unset until signed evidence or a
# controlled UAT record exists for each gate.
MED250_GATE_GPS_READY=
MED250_GATE_WHATSAPP_READY=
MED250_GATE_DUPLICATE_REGISTER_REVIEWED=
MED250_GATE_SECURITY_HARDENING_DEPLOYED=
MED250_GATE_EDGE_FUNCTIONS_DEPLOYED=
MED250_GATE_TURNSTILE_SERVER_VERIFIED=
MED250_GATE_AUTH_RATE_LIMITS_APPROVED=
MED250_GATE_PRESCRIPTION_RETENTION_APPROVED=
MED250_GATE_CLOUDFLARE_ACCOUNT_VERIFIED=
MED250_GATE_DOMAIN_DNS_VERIFIED=
MED250_GATE_PHYSICAL_UAT_PASSED=

# Configure these in Supabase Edge Function secrets, never in the browser.
GOOGLE_MAPS_API_KEY=
# Canonical token for the MED+250 consumer-product review workflow.
MED250_ADMIN_TOKEN=
# Also provide the same value only in the private operations process when using
# the pre-existing pharmacy geocode/contact tools; never pass it as an argument.
# This legacy internal name is retained only for backward compatibility.
DAWANEAR_ADMIN_TOKEN=
DAWANEAR_CRON_TOKEN=
# Server-only Supabase Edge Function secrets (configure in the dashboard; never
# prefix these with NEXT_PUBLIC_ or commit their values):
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_CUSTOMER_OTP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_TEMPLATE_URL_BUTTON_INDEX=0
# WHATSAPP_GRAPH_API_VERSION=v25.0
# Approved utility templates. The pharmacy template body variables are request
# reference, product list, distance band, and fulfilment. The customer template
# variables are request reference, pharmacy name, coverage, and timing/estimate.
# Each template uses URL button 0 with a static prefix of
# https://med-250.com/? and one dynamic query-string parameter.
# WHATSAPP_PHARMACY_REQUEST_TEMPLATE_NAME=
# WHATSAPP_CUSTOMER_OFFER_TEMPLATE_NAME=
# WHATSAPP_PHARMACY_SELECTED_TEMPLATE_NAME=
# WHATSAPP_NOTIFICATION_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_NOTIFICATION_URL_BUTTON_INDEX=0
# WHATSAPP_NOTIFICATION_IMAGE_HEADERS=false
# META_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# DAWANEAR_PHARMACY_OTP_SECRET=
# DAWANEAR_CRON_TOKEN=
# MED250_ALLOWED_ORIGINS=https://med-250.com

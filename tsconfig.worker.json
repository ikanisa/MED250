{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "worker/**/*.ts",
    "db/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "supabase"
  ]
}

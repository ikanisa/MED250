{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "med250-legacy-redirect",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "med250.gikundiro.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
